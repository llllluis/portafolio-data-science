# Configuración de ejemplo. Copia este archivo como .env y completa tus valores.

MODEL_LLM=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Nota mínima para aprobar. Una nota igual se considera aprobada.
PASS_MARK=50.0

# Recursos visuales locales (sustituye por tus propios recursos).
LOGO_ESCOLA=data/logo.png
FOTO_ALUMNE=data/student_ia/{student_id}.jpg
